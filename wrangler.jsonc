{
  "compatibility_date": "2026-11-05",
  "name": "ace66space",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "worker/index.js",
  "routes": [
    {
      "pattern": "ace66.space",
      "custom_domain": true
    },
    {
      "zone_name": "ace66.space",
      "pattern": "www.ace66.space/*"
    }
  ]
}
